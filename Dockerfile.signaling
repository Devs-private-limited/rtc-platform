FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/protocol/package.json packages/protocol/
COPY packages/signaling/package.json packages/signaling/
RUN npm ci
COPY packages/protocol packages/protocol
COPY packages/signaling packages/signaling
RUN npm run build -w @rtc/protocol && npm run build -w @rtc/signaling

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY packages/protocol/package.json packages/protocol/
COPY packages/signaling/package.json packages/signaling/
RUN npm ci --omit=dev --workspace=@rtc/signaling --include-workspace-root
COPY --from=builder /app/packages/protocol/dist packages/protocol/dist
COPY --from=builder /app/packages/signaling/dist packages/signaling/dist
COPY packages/signaling/migrations packages/signaling/migrations
WORKDIR /app/packages/signaling
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:4000/health || exit 1
CMD ["node", "dist/index.js"]
