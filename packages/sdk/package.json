{
  "name": "rtcexpress",
  "version": "0.1.0",
  "description": "RTCExpress Web SDK: add voice calls, video calls and in-app chat to any web app (WebRTC, P2P + SFU).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "author": "Devsquare Labs <support@devsquarelabs.com>",
  "homepage": "https://rtc.devsquarelabs.com",
  "bugs": {
    "url": "https://github.com/Devs-private-limited/rtcexpress-guides/issues",
    "email": "support@devsquarelabs.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Devs-private-limited/rtcexpress-guides.git"
  },
  "keywords": [
    "rtcexpress",
    "webrtc",
    "rtc",
    "voice-call",
    "video-call",
    "chat",
    "in-app-chat",
    "sdk",
    "sfu",
    "mediasoup",
    "agora-alternative",
    "zegocloud-alternative"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "mediasoup-client": "^3.7.16"
  },
  "devDependencies": {
    "@rtc/protocol": "0.1.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
